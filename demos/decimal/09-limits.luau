-- The limits of the 90-bit mantissa: how many digits fit, what happens beyond that, and what overflows.
local function section(title: string) print("\n== " .. title .. " ==") end
local function show(label: string, value: any) print(string.format("%-52s %s", label, tostring(value))) end
local function try(label: string, f: () -> any)
    local ok, result = pcall(f)
    if ok then
        show(label, result)
    else
        show(label, "error: " .. (tostring(result):gsub("^.-:%d+: ", "")))
    end
end

section("the largest and smallest values (the mantissa is 2^90 - 1 at most)")
show("1237940039285380274899124223d (max mantissa)", 1237940039285380274899124223d)
show("-1237940039285380274899124223d", -1237940039285380274899124223d)
show("12379400392853802748991242.23d (scale 2)", 12379400392853802748991242.23d)
show("0.1237940039285380274899124223d (scale 28)", 0.1237940039285380274899124223d)
show("0.0000000000000000000000000001d (smallest step)", 0.0000000000000000000000000001d)
show("9223372036854775807d (the old 64-bit limit)", 9223372036854775807d)
show("any 27 digit number fits", 999999999999999999999999999d)

section("literals that do not fit are syntax errors")
for _, src in {
    "return 1237940039285380274899124224d",
    "return 9999999999999999999999999999d",
    "return 1e28d",
    "return 1e30d",
    "return 0.00000000000000000000000000001d",
    "return 1e-29d",
    "return 1.2.3d",
    "return 1ed",
} do
    local f, err = loadstring(src)
    show(src, f and "compiles" or (err :: string):gsub("^%[.-%]:%d+: ", ""))
end

section("a result with too many digits is rounded, the scale drops")
show("12379400392853802748991242.23d + 0.01d", 12379400392853802748991242.23d + 0.01d)
show("12379400392853802748991242.23d + 0.001d", 12379400392853802748991242.23d + 0.001d)
show("12379400392853802748991242.23d + 0.1d", 12379400392853802748991242.23d + 0.1d)
show("0.1234567890123456789d * 1d", 0.1234567890123456789d * 1d)
show("0.1234567890123456789d * 0.1234567890123456789d", 0.1234567890123456789d * 0.1234567890123456789d)
show("9223372036854775.807d * 1.5d", 9223372036854775.807d * 1.5d)
show("1d / 3d", 1d / 3d)
show("1d / 3d * 3d", 1d / 3d * 3d)

section("the scale is capped at 28")
show("0.0000000000000001d * 0.0000000000000001d", 0.0000000000000001d * 0.0000000000000001d)
show("0.00000000000000000001d * 0.00000000000000000001d", 0.00000000000000000001d * 0.00000000000000000001d)
show("0.0000000000000001d * 0.000000000000000001d", 0.0000000000000001d * 0.000000000000000001d)
show("1d / 9223372036854775807d", 1d / 9223372036854775807d)
show("decimal.create(1e-29)", decimal.create(1e-29))

section("overflow: a value that does not fit even at scale 0")
try("1237940039285380274899124223d + 1d", function() return 1237940039285380274899124223d + 1d end)
try("1237940039285380274899124223d * 2d", function() return 1237940039285380274899124223d * 2d end)
try("1237940039285380274899124223d * 10d", function() return 1237940039285380274899124223d * 10d end)
try("-1237940039285380274899124223d - 1d", function() return -1237940039285380274899124223d - 1d end)
try("100000000000000d * 100000000000000d", function() return 100000000000000d * 100000000000000d end)
show("decimal.mul(10000000000000d, 100000000000000d) (10^27 fits)", decimal.mul(10000000000000d, 100000000000000d))
show("1000000000000d * 1000000000000d (fits)", 1000000000000d * 1000000000000d)
show("1237940039285380274899124222d + 1d (fits)", 1237940039285380274899124222d + 1d)
show("a fraction can round away (…223.4 is …223)", 1237940039285380274899124223d + 0.4d)
try("but the integer part never does (…223.6 would need …224)", function() return 1237940039285380274899124223d + 0.6d end)

section("but digits can be traded for range")
show("123794003928538027489912422.3d + 0.1d", 123794003928538027489912422.3d + 0.1d)
show("123794003928538027489912422.3d * 10d", 123794003928538027489912422.3d * 10d)
try("123794003928538027489912422.3d * 100d", function() return 123794003928538027489912422.3d * 100d end)

section("remainder aligns both operands to a common scale first (256 bits, so it does not overflow)")
show("1d % 0.0000000000000000001d", 1d % 0.0000000000000000001d)
show("1237940039285380274899124223d % 0.0000000000000000000000001d", 1237940039285380274899124223d % 0.0000000000000000000000001d)
show("7d % 0.0000000000000000000000000003d", 7d % 0.0000000000000000000000000003d)

section("what 90 bits are good for")
show("largest amount with 2 decimals", 12379400392853802748991242.23d)
show("largest amount with 4 decimals", 123794003928538027489912.4223d)
show("largest amount with 8 decimals", 12379400392853802748.99124223d)
show("largest amount with 18 decimals", 1237940039.285380274899124223d)
show("one million tokens with 18 decimals", 1000000.000000000000000000d)
show("plus one wei", 1000000.000000000000000000d + 0.000000000000000001d)
show("a billion tokens still fits", 1000000000.000000000000000000d)
show("ten billion tokens does not (fromstring gives nil)", decimal.fromstring("10000000000.000000000000000000"))
