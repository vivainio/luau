
== decimal.create from a number: shortest digits that round-trip ==
create(0.10000000000000001)              0.1
create(0.5)                              0.5
create(0.25)                             0.25
create(2.6749999999999998)               2.675
create(100)                              100
create(-3.5)                             -3.5
create(1.0000000000000001e-05)           0.00001
create(123456.789)                       123456.789
create(0.30000000000000004)              0.30000000000000004
create(0.33333333333333331)              0.3333333333333333
create(0.66666666666666663)              0.6666666666666666
create(1000000000000000)                 1000000000000000
create(1e+18)                            1000000000000000000

== decimal.create from other types ==
create(42)                               42
create(5i)                               5
create('1.50')                           1.50
create('  1.5  ') (whitespace is fine)   1.5
create(2.5d) (decimals pass through)     2.5
create(true)                             error: invalid argument #1 to 'create' (number, integer, string or decimal expected, got boolean)
create({})                               error: invalid argument #1 to 'create' (number, integer, string or decimal expected, got table)
create(nil)                              error: invalid argument #1 to 'create' (number, integer, string or decimal expected, got nil)

== numbers that cannot be decimals give nil ==
create(0/0)                              nil
create(math.huge)                        nil
create(-math.huge)                       nil
create(1e30) (too large)                 nil
create(1e19) (too large)                 10000000000000000000
create(1e-30) (rounds to zero)           0.0000000000000000000000000000

== decimal.fromstring: accepted forms ==
fromstring('0')                          0
fromstring('1')                          1
fromstring('-1')                         -1
fromstring('+1')                         1
fromstring('1.5')                        1.5
fromstring('1.50')                       1.50
fromstring('-1.50')                      -1.50
fromstring('.5')                         0.5
fromstring('5.')                         5
fromstring('0.00')                       0.00
fromstring('007')                        7
fromstring('1e3')                        1000
fromstring('1E3')                        1000
fromstring('1e+3')                       1000
fromstring('1.5e-3')                     0.0015
fromstring('12.5e1')                     125
fromstring('1_000')                      nil

== decimal.fromstring: rejected forms give nil ==
fromstring('')                           nil
fromstring(' ')                          nil
fromstring('abc')                        nil
fromstring('1.2.3')                      nil
fromstring('1e')                         nil
fromstring('e5')                         nil
fromstring('--1')                        nil
fromstring('1,5')                        nil
fromstring('0x10')                       nil
fromstring('1 2')                        nil
fromstring('NaN')                        nil
fromstring('inf')                        nil
fromstring('1e500')                      nil

== more digits than fit are rounded half-even ==
19 digits                                1234567890.123456789
31 digits                                0.1234567890123456789012345679
beyond scale 28                          0.0000000000000000000000000000
beyond scale 28, half                    0.0000000000000000000000000000
too many integer digits                  99999999999999999999

== decimal.tostring and tonumber ==
tostring(0.1)                            0.1  ->  tonumber 0.10000000000000001
tostring(1.50)                           1.50  ->  tonumber 1.5
tostring(100)                            100  ->  tonumber 100
tostring(0.333333333333333333333333333)  0.333333333333333333333333333  ->  tonumber 0.33333333333333331
tostring(12345.6789)                     12345.6789  ->  tonumber 12345.678900000001
tostring(-0.001)                         -0.001  ->  tonumber -0.001
tonumber(1000000d) == 1e6                true
tonumber(0.1d) == 0.1                    true
tonumber(1d/3d) == 1/3                   true

== round trip through a number is only exact for 'nice' values ==
0.5                                      back: 0.5   same: true
0.1                                      back: 0.1   same: true
0.123456789012345678                     back: 0.12345678901234568   same: false

== no implicit conversion ==
decimal.tonumber(5)                      error: invalid argument #1 to 'tonumber' (decimal expected, got number)
decimal.tostring('x')                    error: invalid argument #1 to 'tostring' (decimal expected, got string)
1.5d + decimal.create(1)                 2.5
1.5d + 1                                 error: attempt to perform arithmetic (add) on decimal and number
