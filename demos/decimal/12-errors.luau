-- A catalog of every error a program can hit, with the exact message.
local function section(title: string) print("\n== " .. title .. " ==") end
local function try(label: string, f: () -> any)
    local ok, result = pcall(f)
    local text = ok and ("ok: " .. tostring(result)) or ("error: " .. (tostring(result):gsub("^.-:%d+: ", "")))
    print(string.format("%-34s %s", label, text))
end
local d: any = 1.5d
local n: any = 1
local s: any = "x"

section("arithmetic")
try("overflow (add)", function() return 9223372036854775807d + 1d end)
try("overflow (mul)", function() return 9223372036854775807d * 2d end)
try("overflow (neg is fine)", function() return -(-9223372036854775807d) end)
try("division by zero", function() return 1d / 0d end)
try("remainder by zero", function() return 1d % 0d end)
try("remainder overflow", function() return 9223372036854775807d % 0.0000000000000000000000001d end)
try("floor division", function() return d // d end)
try("exponent", function() return d ^ d end)
try("with a number", function() return d + n end)
try("with a number (left)", function() return n * d end)
try("with a string", function() return d + s end)
try("with nil", function() return d + nil end)
try("with a table", function() return d - {} end)
try("with a function", function() return d * print end)
try("unary minus on a number is fine", function() return -n end)
try("length", function() return #d end)

section("comparison")
try("decimal < number", function() return d < n end)
try("number <= decimal", function() return n <= d end)
try("decimal < string", function() return d < s end)
try("decimal < nil", function() return d < nil end)
try("decimal < table", function() return d < {} end)
try("equality never errors", function() return d == n or d == s or d == nil end)

section("strings")
try("concat right", function() return s .. d end)
try("concat left", function() return d .. s end)
try("concat number", function() return n .. d end)
try("string.format %s", function() return string.format("%s", d) end)
try("string.format %d", function() return string.format("%d", d) end)
try("tostring is fine", function() return tostring(d) end)

section("indexing and calling")
try("index", function() return d.foo end)
try("method call", function() return d:foo() end)
try("newindex", function() d.foo = 1 end)
try("call", function() return d() end)
try("table key", function() local t = {} t[d] = 1 end)
try("table key via rawset", function() rawset({}, d, 1) end)
try("table key in constructor", function() return { [d] = 1 } end)
try("table read is fine", function() return ({})[d] end)
try("next with decimal key", function() return next({}, d) end)

section("library arguments")
try("add(1, 2d)", function() return decimal.add(1, 2d) end)
try("add(1d)", function() return decimal.add(1d) end)
try("add()", function() return (decimal.add :: any)() end)
try("add('1', 2d)", function() return decimal.add("1", 2d) end)
try("tonumber(1)", function() return decimal.tonumber(1) end)
try("tostring({})", function() return decimal.tostring({}) end)
try("round(1d, 29)", function() return decimal.round(1d, 29) end)
try("round(1d, -1)", function() return decimal.round(1d, -1) end)
try("round(1d, 'x')", function() return decimal.round(1d, "x") end)
try("round(1d, 0, 'up')", function() return decimal.round(1d, 0, "up") end)
try("round(1d, 0, 5)", function() return decimal.round(1d, 0, 5) end)
try("max()", function() return decimal.max() end)
try("min(1d, 'x')", function() return decimal.min(1d, "x") end)
try("create({})", function() return decimal.create({}) end)
try("create(true)", function() return decimal.create(true) end)
try("fromstring(5)", function() return decimal.fromstring(5) end)
try("fromstring() ", function() return (decimal.fromstring :: any)() end)
try("scale('x')", function() return decimal.scale("x") end)

section("not errors, but nil")
try("create(0/0)", function() return decimal.create(0 / 0) end)
try("create(1e30)", function() return decimal.create(1e30) end)
try("fromstring('abc')", function() return decimal.fromstring("abc") end)
try("fromstring('1e500')", function() return decimal.fromstring("1e500") end)

section("syntax errors")
for _, src in { "return 1.2.3d", "return 1ed", "return 9223372036854775808d", "return 1e30d", "return 0.00000000000000000000000000001d", "return 1d2", "return 0xd" } do
    local f, err = loadstring(src)
    print(string.format("%-34s %s", src, f and "compiles" or (err :: string):gsub("^%[.-%]:%d+: ", "")))
end
